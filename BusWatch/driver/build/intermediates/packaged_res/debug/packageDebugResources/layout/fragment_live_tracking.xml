<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 1. MAIN CONTENT (Header + Banner + Map) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP HEADER -->
        <RelativeLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/square_shape"
            android:paddingHorizontal="16dp"
            android:elevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/header_logo"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:contentDescription="@string/logo"
                    android:src="@drawable/logo_with_bg" />

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/buswatch"
                    android:textColor="#040303"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSOS"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sos"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:contentDescription="@string/emergency" />
        </RelativeLayout>

        <!-- Next Stop Banner -->
        <LinearLayout
            android:id="@+id/bannerNextStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/yellow_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRouteInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="ROUTE A • BUS-001" />

                <TextView
                    android:id="@+id/tvNextStopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Main Entrance Gate" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvETA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_eta_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="ETA - 10 MINS" />
        </LinearLayout>

        <!-- Map Area -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.maplibre.android.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMaximizeMap"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="#CCFFFFFF"
                    android:contentDescription="@string/maximize_map"
                    android:elevation="4dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/black" />

                <ImageButton
                    android:id="@+id/btnCompass"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="#CCFFFFFF"
                    android:contentDescription="@string/reset_orientation"
                    android:elevation="4dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_compass"
                    android:visibility="gone"
                    app:tint="@color/black" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 2. SCROLLABLE BOTTOM ROSTER (Bottom Sheet) -->
    <LinearLayout
        android:id="@+id/layoutBottomInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yellow_primary"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:elevation="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="300dp">

        <View
            android:id="@+id/conductor_top_spacer"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:visibility="gone" />

        <View
            android:id="@+id/roster_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/rectangle_shape"
            android:backgroundTint="#44000000" />

        <RelativeLayout
            android:id="@+id/roster_header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/tvRosterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/student_roster_caps"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBoardingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/btnSortRoster"
                android:layout_marginEnd="8dp"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="0 / 40 On Board" />

            <ImageButton
                android:id="@+id/btnSortRoster"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_filter"
                android:contentDescription="@string/sort"
                app:tint="@color/black" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPickup"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_pickup_row"
            tools:itemCount="5" />

        <!-- Footer divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:background="#1A000000" />

        <!-- Action Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/btnDropAll"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_end_trip"
                android:backgroundTint="@color/accessible_error_red"
                android:gravity="center"
                android:text="@string/drop_all"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/btnEndTrip"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_end_trip"
                android:gravity="center"
                android:text="@string/end_trip"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Anchored Map UI (Floating above the sheet handle) -->
    <LinearLayout
        android:id="@+id/layoutStreetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_anchor="@id/layoutBottomInfo"
        app:layout_anchorGravity="top|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_eta_badge"
        android:backgroundTint="#CC1A1A1A"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:elevation="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_location"
            app:tint="@color/white"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/my_location"/>

        <TextView
            android:id="@+id/tvCurrentStreet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detecting street..."
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMyLocation"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_anchor="@id/layoutBottomInfo"
        app:layout_anchorGravity="top|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/circle_shape"
        android:backgroundTint="#CCFFFFFF"
        android:contentDescription="@string/my_location"
        android:elevation="20dp"
        android:padding="12dp"
        android:src="@drawable/ic_my_location"
        app:tint="@color/black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
