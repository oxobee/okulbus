<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 1. Map Area (Base Layer - fills entire screen) -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Header Section (Overlay) -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/dark_header"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_button"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        android:elevation="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerBackground"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvLiveTrackingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/live_tracking"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="9dp"
        app:layout_constraintBottom_toTopOf="@+id/tvChildName"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@+id/headerBackground"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvChildName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_white_secondary"
        android:textSize="11sp"
        android:elevation="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerBackground"
        app:layout_constraintStart_toStartOf="@+id/tvLiveTrackingTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvLiveTrackingTitle"
        tools:text="Justin Wilson" />

    <!-- 3. Next Stop Banner (Overlay) -->
    <LinearLayout
        android:id="@+id/bannerNextStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yellow_primary"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerBackground">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRouteInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="ROUTE A • BUS-001" />

            <TextView
                android:id="@+id/tvNextStopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Main Entrance Gate" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvETA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_eta_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="ETA - 10 MINS" />
    </LinearLayout>

    <!-- Floating Controls (Z-index above map) -->
    <ImageButton
        android:id="@+id/btnMaximizeMap"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/circle_shape"
        android:backgroundTint="#CCFFFFFF"
        android:contentDescription="@string/maximize_map"
        android:elevation="10dp"
        android:padding="10dp"
        android:src="@drawable/ic_eye"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerNextStop"
        app:tint="@color/black" />

    <ImageButton
        android:id="@+id/btnMyLocation"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:background="@drawable/circle_shape"
        android:backgroundTint="#CCFFFFFF"
        android:contentDescription="@string/locate_bus"
        android:elevation="10dp"
        android:padding="12dp"
        android:src="@drawable/ic_my_location"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#4A90E2" />

    <!-- 4. Bottom Info Section (Overlay) -->
    <RelativeLayout
        android:id="@+id/layoutBottomInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yellow_primary"
        android:elevation="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:background="@drawable/rectangle_shape"
            android:backgroundTint="#44000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="60dp">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Mike Johnson" />

            <TextView
                android:id="@+id/tvBusStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:text="Bus Driver • BUS-001" />

            <LinearLayout
                android:id="@+id/btnMapBusDetails"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/rectangle_shape_black"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/bus_details_caps"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Floating Driver Avatar Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvAvatarContainer"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="-50dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="50dp"
        app:cardElevation="15dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/yellow_primary"
        app:strokeWidth="4dp">

        <ImageView
            android:id="@+id/ivDriverAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder"
            tools:src="@drawable/user" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>