<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header Section -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="@color/dark_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBackStopDetail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_button"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="@id/headerBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerBg"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/stop_details"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/headerBg"
        app:layout_constraintStart_toEndOf="@id/btnBackStopDetail"
        app:layout_constraintTop_toTopOf="@id/headerBg" />

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollStopDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Stop Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_details_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical"
                    android:text="@string/stop_information"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <!-- Stop Name Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stop_name_label" android:textColor="@color/gray_text" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="4dp"
                        tools:ignore="SmallSp" />
                    <TextView
                        android:id="@+id/tvStopName"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/rectangle_hollow_with_shadow"
                        android:paddingHorizontal="12dp" android:textSize="14sp"
                        android:gravity="center_vertical" android:textColor="@color/black"
                        android:text="@string/placeholder_hyphen"/>
                </LinearLayout>

                <!-- Coordinates Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/coordinates_label" android:textColor="@color/gray_text" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="4dp"
                        tools:ignore="SmallSp" />
                    <TextView
                        android:id="@+id/tvStopCoordinates"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/rectangle_hollow_with_shadow"
                        android:paddingHorizontal="12dp" android:textSize="14sp"
                        android:gravity="center_vertical" android:textColor="@color/black"
                        android:text="@string/placeholder_hyphen"/>
                </LinearLayout>

                <!-- Map View Area -->
                <FrameLayout
                    android:id="@+id/mapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:background="@drawable/rectangle_hollow">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <org.maplibre.android.maps.MapView
                            android:id="@+id/mapStopView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Eye Icon - Top Right -->
                        <ImageButton
                            android:id="@+id/btnMaximizeMap"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_circle_white"
                            android:elevation="4dp"
                            android:src="@drawable/ic_eye"
                            app:tint="@color/black"
                            android:contentDescription="@string/view" />

                        <!-- Attribution Overlay -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentStart="true"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="#80FFFFFF"
                            android:elevation="2dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="© OpenStreetMap contributors"
                            android:textColor="#444444"
                            android:textSize="8sp"
                            tools:ignore="SmallSp" />

                        <!-- Re-center Icon - Bottom Right -->
                        <ImageButton
                            android:id="@+id/btnRecenterStop"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_circle_white"
                            android:elevation="4dp"
                            android:src="@drawable/ic_my_location"
                            app:tint="#2196F3"
                            android:contentDescription="@string/my_location" />

                    </RelativeLayout>
                </FrameLayout>

            </LinearLayout>

            <!-- Assigned Students Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_details_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/tvAssignedTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/assigned_students"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/tvStopStudentCount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 Students"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp"
                        android:layout_toEndOf="@id/tvAssignedTitle"
                        android:layout_marginStart="8dp"
                        android:layout_centerVertical="true"
                        tools:ignore="HardcodedText" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAssignedStudents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_stop_assigned_student"
                    tools:itemCount="2"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>