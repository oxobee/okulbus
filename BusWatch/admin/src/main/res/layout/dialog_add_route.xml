<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_details_card"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Add Route"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <ImageButton
                android:id="@+id/btnCloseAddRoute"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/black"
                android:contentDescription="Close" />
        </RelativeLayout>

        <!-- Route Name -->
        <LinearLayout
            android:id="@+id/layoutRouteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Route Name *" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etRouteName"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/rectangle_hollow_with_shadow"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp"
                android:inputType="textCapWords" android:hint="e.g. Route A" android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- Driver Selection -->
        <LinearLayout
            android:id="@+id/layoutDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Assign Driver *" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <FrameLayout android:id="@+id/btnDriverDropdown"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/rectangle_hollow_with_shadow"
                android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/tvSelectedDriver"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" android:layout_marginStart="12dp"
                    android:text="Select Driver" android:textColor="#888888" android:textSize="14sp"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center_vertical|end" android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_chevron_down" app:tint="#888888" android:contentDescription="@null"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Conductor Selection -->
        <LinearLayout
            android:id="@+id/layoutConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Assign Conductor (Optional)" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <FrameLayout android:id="@+id/btnConductorDropdown"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/rectangle_hollow_with_shadow"
                android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/tvSelectedConductor"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" android:layout_marginStart="12dp"
                    android:text="Select Conductor" android:textColor="#888888" android:textSize="14sp"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center_vertical|end" android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_chevron_down" app:tint="#888888" android:contentDescription="@null"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Bus & Capacity Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:baselineAligned="false">
            <LinearLayout
                android:id="@+id/layoutBus"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Bus *" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <FrameLayout android:id="@+id/btnBusDropdown"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/rectangle_hollow_with_shadow"
                    android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/tvSelectedBus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" android:layout_marginStart="12dp"
                        android:text="Bus No." android:textColor="#888888" android:textSize="14sp"/>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_gravity="center_vertical|end" android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_chevron_down" app:tint="#888888" android:contentDescription="@null"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutCapacity"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Capacity" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvBusCapacity"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/rectangle_hollow_with_shadow"
                    android:paddingHorizontal="12dp" android:textSize="14sp"
                    android:gravity="center_vertical" android:textColor="@color/black"
                    android:text="@string/_12_seats"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Morning Schedule -->
        <LinearLayout
            android:id="@+id/layoutMorningTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Morning Schedule" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/tvMorningStart"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="@drawable/rectangle_hollow_with_shadow"
                    android:paddingHorizontal="12dp" android:textSize="13sp" android:gravity="center_vertical"
                    android:hint="Start Time" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/tvMorningEnd"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="@drawable/rectangle_hollow_with_shadow"
                    android:paddingHorizontal="12dp" android:textSize="13sp" android:gravity="center_vertical"
                    android:hint="End Time" android:layout_marginStart="6dp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Afternoon Schedule -->
        <LinearLayout
            android:id="@+id/layoutAfternoonTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Afternoon Schedule" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/tvAfternoonStart"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="@drawable/rectangle_hollow_with_shadow"
                    android:paddingHorizontal="12dp" android:textSize="13sp" android:gravity="center_vertical"
                    android:hint="Start Time" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/tvAfternoonEnd"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="@drawable/rectangle_hollow_with_shadow"
                    android:paddingHorizontal="12dp" android:textSize="13sp" android:gravity="center_vertical"
                    android:hint="End Time" android:layout_marginStart="6dp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Stop Selection Label -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Select Stops on Map *" android:textColor="#444444" android:textSize="12sp" android:textStyle="bold"
                android:layout_alignParentStart="true" android:layout_centerVertical="true"/>
            <TextView android:id="@+id/tvSelectedStopsCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                android:text="0 Stops Selected" android:textColor="@color/yellow_dark" android:textSize="11sp" android:textStyle="bold"/>
        </RelativeLayout>

        <!-- Map Picker Container -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/rectangle_hollow_with_shadow">

            <org.maplibre.android.maps.MapView
                android:id="@+id/mapRoutePicker"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Eye Icon (Maximize) -->
            <ImageButton
                android:id="@+id/btnMaximizeMap"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#CCFFFFFF"
                android:src="@drawable/ic_eye"
                android:padding="8dp"
                android:elevation="6dp"
                app:tint="@color/black"
                android:contentDescription="Maximize Map" />

            <!-- Attribution Overlay -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:background="#80FFFFFF"
                android:elevation="2dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/osm_attribution"
                android:textColor="#444444"
                android:textSize="8sp"
                tools:ignore="SmallSp" />

            <!-- Recenter Icon -->
            <ImageButton
                android:id="@+id/btnMyLocation"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#CCFFFFFF"
                android:src="@drawable/ic_my_location"
                android:padding="10dp"
                android:elevation="6dp"
                app:tint="@color/black"
                android:contentDescription="Recenter Stops" />
        </FrameLayout>

        <!-- Save Button -->
        <TextView
            android:id="@+id/btnSaveRoute"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_yellow"
            android:text="CREATE ROUTE"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:letterSpacing="0.05" />

    </LinearLayout>
</ScrollView>
